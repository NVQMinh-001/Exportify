{
  "name": "@exportify/compression",
  "version": "0.0.0",
  "private": true,
  "description": "WebAssembly-based asset compression (SVGO, jsquash) running in a Comlink Web Worker.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./svg": "./src/svg.ts",
    "./raster": "./src/raster.ts",
    "./matrix": "./src/matrix.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo coverage .tsbuildinfo"
  },
  "dependencies": {
    "@exportify/core-engine": "workspace:*",
    "@exportify/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@exportify/eslint-config": "workspace:*",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
