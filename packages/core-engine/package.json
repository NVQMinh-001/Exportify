{
  "name": "@exportify/core-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript engine for renaming, foldering, and pipeline coordination. No DOM dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rename": "./src/rename/index.ts",
    "./folder": "./src/folder/index.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:strict-perf": "vitest run --coverage=false src/rename/index.test.ts -t \"50 000-item\"",
    "clean": "rimraf dist .turbo coverage .tsbuildinfo"
  },
  "devDependencies": {
    "@exportify/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "safe-regex": "^2.1.1",
    "zod": "^3.23.8"
  }
}
