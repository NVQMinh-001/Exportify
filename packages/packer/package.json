{
  "name": "@exportify/packer",
  "version": "0.0.0",
  "private": true,
  "description": "Streaming ZIP packer that consumes the folder tree from the core engine. fflate under the hood.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./zip": "./src/zip.ts",
    "./folder-tree": "./src/folder-tree.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo coverage .tsbuildinfo"
  },
  "dependencies": {
    "@exportify/core-engine": "workspace:*",
    "@exportify/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@exportify/eslint-config": "workspace:*",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
