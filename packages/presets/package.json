{
  "name": "@exportify/presets",
  "version": "0.0.0",
  "private": true,
  "description": "Built-in and user-defined export presets. Plain JSON, Zod-validated, shareable across apps.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react-native": "./src/react-native.ts",
    "./web-app": "./src/web-app.ts",
    "./marketing": "./src/marketing.ts",
    "./icon-library": "./src/icon-library.ts",
    "./custom": "./src/custom.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo coverage .tsbuildinfo"
  },
  "dependencies": {
    "@exportify/compression": "workspace:*",
    "@exportify/core-engine": "workspace:*",
    "@exportify/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@exportify/eslint-config": "workspace:*",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
