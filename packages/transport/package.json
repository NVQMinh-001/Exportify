{
  "name": "@exportify/transport",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-boundary message bridges and Zod schemas for sandbox <-> iframe, popup <-> service worker, and service worker <-> offscreen document.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./figma-bridge": "./src/figma-bridge.ts",
    "./extension-bridge": "./src/extension-bridge.ts",
    "./schemas": "./src/schemas.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo coverage .tsbuildinfo"
  },
  "dependencies": {
    "@exportify/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@exportify/eslint-config": "workspace:*",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
