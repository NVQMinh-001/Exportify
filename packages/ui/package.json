{
  "name": "@exportify/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React 18 UI: components, hooks, theme tokens, zustand stores. Tailwind v3, lucide icons.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./theme": "./src/theme/index.ts",
    "./store": "./src/store/index.ts",
    "./icons": "./src/icons/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo coverage .tsbuildinfo"
  },
  "dependencies": {
    "@exportify/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@exportify/eslint-config": "workspace:*",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
