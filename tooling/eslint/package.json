{
  "name": "@exportify/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint flat configs for the Exportify monorepo.",
  "type": "module",
  "main": "./base.mjs",
  "exports": {
    "./base": "./base.mjs",
    "./node": "./node.mjs",
    "./react": "./react.mjs",
    "./lib": "./lib.mjs"
  },
  "files": [
    "base.mjs",
    "node.mjs",
    "react.mjs",
    "lib.mjs"
  ],
  "scripts": {
    "lint": "echo \"(eslint-config has no source to lint)\" && exit 0",
    "typecheck": "echo \"(eslint-config has no source to typecheck)\" && exit 0",
    "test": "echo \"(eslint-config has no tests)\" && exit 0",
    "build": "echo \"(eslint-config has no build step)\" && exit 0",
    "clean": "rimraf node_modules .turbo dist"
  },
  "dependencies": {
    "@eslint/js": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.19.0"
  },
  "peerDependencies": {
    "eslint": "^9.17.0"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
